---
import MainHead from '../components/MainHead.astro';
import Nav from '../components/Nav.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
---
<html lang="en">
  <head>
    <MainHead title="Aniruddh Srivastava — intro study" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preload" href="/fonts/eb-garamond/regular.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <Nav hideNavLinks />
    <main>
      <header>
        <p class="eyebrow">A brief introduction</p>
        <h1>Aniruddh Srivastava<span class="period">.</span></h1>
      </header>
      <!-- Edit your intro here. Add/remove <p> blocks as needed; the first is larger.
           Use <em> for navy italics, <strong> for emphasis, and <a href="…"> for links. -->
      <article aria-label="About me">
        <p>Online, I go by <em>Noir</em>.</p>
        <p>
          Senior in CS at <a href="https://www.cs.purdue.edu/">Purdue</a> with minors
          in Math, Physics, and ECE. Interested in product management alongside
          systems programming and formal verification.
        </p>
        <p>
          Interested in systems programming, formal verification, and computer
          architecture. Currently researching LLM-assisted theorem proving in
          Rocq and Lean.
        </p>
        <p>Annual <a href="https://adventofcode.com/">Advent of Code</a> participant.</p>
      </article>
      <p class="draft">Typography study · production homepage unchanged</p>
    </main>
    <div class="music-shell"><MusicPlayer /></div>
  </body>
</html>
<style>
  @font-face { font-family: 'EB Garamond'; src: url('/fonts/eb-garamond/regular.ttf') format('truetype'); font-style: normal; font-weight: 400; font-display: swap; }
  @font-face { font-family: 'EB Garamond'; src: url('/fonts/eb-garamond/italic.ttf') format('truetype'); font-style: italic; font-weight: 400; font-display: swap; }
  /* Reading width and outer spacing. */
  main { width: min(100% - 3rem, 760px); margin: 0 auto; padding: 0.25rem 0 5rem; }
  header { margin-bottom: 2rem; }
  .eyebrow { font-size: 10px; text-transform: uppercase; letter-spacing: .15em; color: var(--gray-400); margin-bottom: 1rem; }
  h1 { font-family: 'EB Garamond', Georgia, serif; font-weight: 400; font-size: clamp(2.7rem, 5vw, 4.1rem); letter-spacing: -.035em; line-height: 1.08; color: var(--gray-0); }
  .period { color: var(--accent-strong); }
  /* Intro type size, line spacing, and inline treatments. */
  article { font-family: 'EB Garamond', Georgia, serif; font-size: clamp(1.3rem, 2vw, 1.6rem); line-height: 1.38; letter-spacing: -.012em; color: #302e36; }
  article p { margin-bottom: 1.1rem; text-wrap: pretty; }
  article p:first-child { font-size: 1.15em; margin-bottom: 1.25rem; }
  article em { color: var(--gray-0); }
  article strong { font-weight: 600; }
  article a { color: inherit; text-decoration-color: var(--accent-strong); text-decoration-thickness: 1px; text-underline-offset: .13em; }
  article a:hover { color: var(--accent-strong); }
  article a:focus-visible { outline: 2px solid var(--accent-strong); outline-offset: 4px; }
  .draft { font-size: 9px; color: var(--gray-400); margin-top: 1.5rem; }
  /* Mobile: allow the page to grow and keep music below the copy. */
  @media (max-width: 50em) {
    :global(nav) { margin-bottom: 1.75rem; }
    main { padding-top: .25rem; padding-bottom: 2rem; }
    .music-shell { margin: 0 1.5rem 2rem; }
    .music-shell :global(music-player) { position: static; display: block; }
    header { margin-bottom: 1.6rem; }
    article { font-size: 22px; line-height: 1.4; }
    article p:first-child { font-size: 25px; }
    .draft { font-size: 9px; line-height: 1.7; }
  }
</style>
